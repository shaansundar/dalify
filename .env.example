# Shopify Storefront API
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-access-token

# Shopify Webhooks (server-side only)
SHOPIFY_WEBHOOK_SECRET=your-webhook-secret

# Shopify Admin API (for admin dashboard)
SHOPIFY_ADMIN_API_ACCESS_TOKEN=your-admin-api-access-token
SHOPIFY_ADMIN_API_VERSION=2025-01

# Database (PostgreSQL on Railway)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Auth (admin dashboard authentication)
AUTH_SECRET=your-auth-secret
AUTH_URL=https://your-deployment-url.up.railway.app

# Google OAuth (optional — leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to "true" to show Google sign-in button on login page
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Seed (initial admin user — used by `pnpm db:seed`)
ADMIN_EMAIL=admin@dalify.in
ADMIN_PASSWORD=change-me-immediately

# Analytics (optional — scripts only load when set)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=1234567890

# Sentry (error tracking — app loads without it, but errors won't be reported)
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Site URL (used for SEO canonical URLs, sitemap, and Open Graph)
# NEXT_PUBLIC_SITE_URL=https://dalify.in
