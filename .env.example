# Shopify Storefront API
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-access-token

# Shopify Webhooks (server-side only)
SHOPIFY_WEBHOOK_SECRET=your-webhook-secret

# Shopify Admin API (for admin dashboard)
SHOPIFY_ADMIN_API_ACCESS_TOKEN=your-admin-api-access-token
SHOPIFY_ADMIN_API_VERSION=2025-01

# Database (PostgreSQL on Railway)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Auth (admin dashboard authentication)
AUTH_SECRET=your-auth-secret
AUTH_URL=https://your-deployment-url.up.railway.app/admin

# Analytics (optional — scripts only load when set)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=1234567890

# Site URL (used for SEO canonical URLs, sitemap, and Open Graph)
# NEXT_PUBLIC_SITE_URL=https://dalify.in
